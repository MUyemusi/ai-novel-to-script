{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-novel-to-script.local/schemas/screenplay_schema.json",
  "title": "Screenplay YAML MVP Schema",
  "type": "object",
  "required": ["screenplay"],
  "additionalProperties": true,
  "properties": {
    "screenplay": {
      "type": "object",
      "required": ["meta", "source_novel", "characters", "acts", "quality_report"],
      "additionalProperties": true,
      "properties": {
        "title": { "type": "string" },
        "type": { "type": "string" },
        "meta": {
          "type": "object",
          "additionalProperties": true
        },
        "source_novel": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "chapter_count": { "type": "integer", "minimum": 0 }
          }
        },
        "characters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "name": { "type": "string" },
              "role": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        },
        "acts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["scenes"],
            "additionalProperties": true,
            "properties": {
              "act_id": { "type": "string" },
              "title": { "type": "string" },
              "summary": { "type": "string" },
              "scenes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "scene_id": { "type": "string" },
                    "title": { "type": "string" },
                    "source_chapter_id": { "type": "string" },
                    "interior_exterior": { "type": "string" },
                    "slugline": { "type": "string" },
                    "transition": { "type": "string" },
                    "location": { "type": "string" },
                    "time": { "type": "string" },
                    "summary": { "type": "string" },
                    "characters": {
                      "type": "array"
                    },
                    "actions": {
                      "type": "array"
                    },
                    "beats": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": true,
                        "properties": {
                          "type": { "type": "string" },
                          "content": { "type": "string" },
                          "description": { "type": "string" },
                          "action": { "type": "string" },
                          "character": { "type": "string" },
                          "line": { "type": "string" }
                        }
                      }
                    },
                    "dialogues": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": true,
                        "properties": {
                          "character": { "type": "string" },
                          "line": { "type": "string" },
                          "parenthetical": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "quality_report": {
          "type": "object",
          "required": [
            "chapter_count",
            "scene_count",
            "character_count",
            "chapter_coverage_rate"
          ],
          "additionalProperties": true,
          "properties": {
            "chapter_count": { "type": "integer", "minimum": 0 },
            "scene_count": { "type": "integer", "minimum": 0 },
            "character_count": { "type": "integer", "minimum": 0 },
            "chapter_coverage_rate": {
              "oneOf": [
                { "type": "number", "minimum": 0, "maximum": 1 },
                { "type": "string" }
              ]
            }
          }
        }
      }
    }
  }
}
